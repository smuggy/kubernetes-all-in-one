apiVersion: kubeadm.k8s.io/v1beta3
kind: ClusterConfiguration
kubernetesVersion: v1.33.0 # Replace with your desired Kubernetes version
controlPlaneEndpoint: "{{ ip_address }}:6443" # Replace with your control plane IP
networking:
  podSubnet: "10.244.0.0/16" # Replace with your desired pod network CIDR
---
apiVersion: kubeadm.k8s.io/v1beta3
kind: InitConfiguration
nodeRegistration:
  criSocket: "/var/run/containerd/containerd.sock" # Adjust for your CRI socket
  taints: [] # This line removes the default control-plane taint
